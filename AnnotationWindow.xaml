<Window x:Class="Snatch.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="캡처 편집" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
KeyDown="OnKey" PreviewKeyDown="OnPreviewKey" PreviewMouseWheel="OnPreviewWheel">
    <Window.Resources>
        <!-- 툴바 버튼: 평소엔 투명, 올리면 옅은 흰색, 선택된 도구는 코드에서 macOS 파랑(#0A84FF) -->
        <Style x:Key="TbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E8E8EC"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="hv" Background="#1AFFFFFF" CornerRadius="8" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hv" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hv" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 신호등 버튼 (빨강=닫기, 노랑=최소화, 초록=맞춤/100%) — 올리면 기호 표시 -->
        <Style x:Key="TbIconBtn" TargetType="Button" BasedOn="{StaticResource TbBtn}">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
        </Style>
        <Style x:Key="TbIco" TargetType="Image">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
        </Style>
        <Style x:Key="LightBtn" TargetType="Button">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="#33000000" StrokeThickness="0.5"/>
                            <TextBlock x:Name="glyph" Text="{TemplateBinding Content}" FontSize="10" FontWeight="Bold" Foreground="#99000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="glyph" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 맥 스타일 얇은 스크롤바 (트랙 없음, 반투명 막대만) -->
        <Style x:Key="ThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="tb" Background="#59FFFFFF" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tb" Property="Background" Value="#8CFFFFFF"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="tb" Property="Background" Value="#B3FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}"/></Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#A6FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Margin" Value="7,6"/>
        </Style>
    </Window.Resources>

    <!-- 바깥 여백 = 그림자 자리 -->
    <Grid Margin="18">
        <!-- 그림자 전용 (내용과 분리해서 글자가 흐려지지 않게) -->
        <Border CornerRadius="12" Background="#FF1C1C1F">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="Black"/></Border.Effect>
        </Border>
        <Border CornerRadius="12" Background="#FF1C1C1F" BorderBrush="#26FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 제목줄 (잡고 끌면 창 이동) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleDown">
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource LightBtn}" Background="#FF5F57" Content="×" ToolTip="닫기 (Esc)" Click="OnClose"/>
                        <Button Style="{StaticResource LightBtn}" Background="#FEBC2E" Content="−" ToolTip="최소화" Click="OnMinimize"/>
                        <Button Style="{StaticResource LightBtn}" Background="#28C840" Content="+" ToolTip="화면에 맞춤 / 100% (Ctrl+0)" Click="OnZoomFit"/>
                    </StackPanel>
                    <TextBlock Text="캡처 편집" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#8CFFFFFF" FontSize="12" FontWeight="SemiBold" IsHitTestVisible="False"/>
                </Grid>

                <!-- 캔버스 (채움) — 하단은 플로팅 툴바 자리 확보 -->
                <Border Grid.Row="1" Padding="10,0,10,100">
                    <Grid>
                        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <!-- 보기 확대/축소는 바깥 Grid에만 적용 (Surface 좌표·저장 해상도는 그대로). 작아지면 가운데 정렬 -->
                            <Grid x:Name="Zoomer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.LayoutTransform><ScaleTransform x:Name="ZoomTx" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                                <Canvas x:Name="Surface" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        MouseLeftButtonDown="OnDown" MouseMove="OnMove" MouseLeftButtonUp="OnUp"
                                        MouseWheel="OnWheel" ClipToBounds="True">
                                    <Image x:Name="BaseImage" SnapsToDevicePixels="True"/>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <Border x:Name="DimToast" Opacity="0" IsHitTestVisible="False"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                                Background="#D91C1C1F" CornerRadius="16" Padding="14,6"
                                BorderBrush="#26FFFFFF" BorderThickness="1">
                            <TextBlock x:Name="DimToastText" Foreground="#F2FFFFFF" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 도구 플로팅 패널 (하단 중앙) -->
                <Border x:Name="ToolBar" Grid.Row="1" Background="#F02A2A2E" CornerRadius="14" Padding="8,7"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                        BorderBrush="#1FFFFFFF" BorderThickness="1"
                        MouseLeftButtonDown="OnToolbarDown" MouseMove="OnToolbarMove" MouseLeftButtonUp="OnToolbarUp">
                    <Border.RenderTransform><TranslateTransform x:Name="TbTx"/></Border.RenderTransform>
                    <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.45" Color="Black"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnSel" ToolTip="선택 (V) — 클릭해서 옮기기·크기 조절·Del 삭제·색 바꾸기" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="select"><StackPanel><Path Data="M3,1 L3,15 L6.8,11.4 L9.6,17.2 L12,16 L9.3,10.4 L14.2,10.2 Z" Fill="#E8E8EC" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="V 선택" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnSpot"  ToolTip="스포트라이트 (1)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="spot"><StackPanel><Image Source="/icons/spot.png" Style="{StaticResource TbIco}"/><TextBlock Text="1 스포트" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnArrow" ToolTip="화살표 (2)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="arrow"><StackPanel><Image Source="/icons/arrow.png" Style="{StaticResource TbIco}"/><TextBlock Text="2 화살표" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnRect"  ToolTip="사각형 (3)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="rect"><StackPanel><Image Source="/icons/rect.png" Style="{StaticResource TbIco}"/><TextBlock Text="3 사각형" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnEll"   ToolTip="원 (4)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="ellipse"><StackPanel><Image Source="/icons/ellipse.png" Style="{StaticResource TbIco}"/><TextBlock Text="4 원" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnPen"   ToolTip="펜 (5)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="pen"><StackPanel><Image Source="/icons/pen.png" Style="{StaticResource TbIco}"/><TextBlock Text="5 펜" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnHl"    ToolTip="형광펜 (6)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="hl"><StackPanel><Image Source="/icons/hl.png" Style="{StaticResource TbIco}"/><TextBlock Text="6 형광펜" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnBlur"  ToolTip="블러 (7)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="blur"><StackPanel><Image Source="/icons/blur.png" Style="{StaticResource TbIco}"/><TextBlock Text="7 블러" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnText"  ToolTip="텍스트 (8)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="text"><StackPanel><Image Source="/icons/text.png" Style="{StaticResource TbIco}"/><TextBlock Text="8 텍스트" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnCallout" ToolTip="콜아웃 (9)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="callout"><StackPanel><Image Source="/icons/callout.png" Style="{StaticResource TbIco}"/><TextBlock Text="9 콜아웃" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button x:Name="BtnNum"   ToolTip="넘버 (0)" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="num"><StackPanel><Image Source="/icons/num.png" Style="{StaticResource TbIco}"/><TextBlock Text="0 넘버" Style="{StaticResource Lbl}"/></StackPanel></Button>

                            <Button x:Name="BtnCrop" ToolTip="자르기 (C) — 드래그 후 Enter·더블클릭" Style="{StaticResource TbIconBtn}" Click="OnTool" Tag="crop"><StackPanel><Path Data="M5,1 L5,13 L17,13 M1,5 L13,5 L13,17" Stroke="#E8E8EC" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="C 자르기" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Border Style="{StaticResource Sep}"/>
                            <!-- 색상: 현재 색 동그라미, 누르면 팔레트 -->
                            <Button x:Name="BtnColor" ToolTip="색상" Style="{StaticResource TbIconBtn}" Click="OnColorBtn">
                                <StackPanel>
                                    <Ellipse x:Name="ColorDot" Width="18" Height="18" Stroke="#D9FFFFFF" StrokeThickness="2" Fill="#FF3B30"/>
                                    <TextBlock Text="색상" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                            </Button>
                            <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=BtnColor}" Placement="Top"
                                   VerticalOffset="-10" HorizontalOffset="-70" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="#F72A2A2E" CornerRadius="12" Padding="10" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,0,4">
                                    <StackPanel>
                                        <WrapPanel x:Name="ColorGrid" Width="180"/>
                                        <Button Content="사용자 지정…" Style="{StaticResource TbBtn}" Height="28" Margin="0,8,0,0"
                                                Background="#14FFFFFF" HorizontalAlignment="Stretch" Click="OnCustomColor"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Border Style="{StaticResource Sep}"/>
                            <Button ToolTip="실행취소 (Ctrl+Z)" Style="{StaticResource TbIconBtn}" Click="OnUndo"><StackPanel><Image Source="/icons/undo.png" Style="{StaticResource TbIco}"/><TextBlock Text="취소" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button ToolTip="다시 실행 (Ctrl+Shift+Z / Ctrl+Y)" Style="{StaticResource TbIconBtn}" Click="OnRedo"><StackPanel><Image Source="/icons/undo.png" Style="{StaticResource TbIco}" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><ScaleTransform ScaleX="-1"/></Image.RenderTransform></Image><TextBlock Text="다시" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button ToolTip="복사 (Ctrl+C)" Style="{StaticResource TbIconBtn}" Click="OnCopy"><StackPanel><Image Source="/icons/copy.png" Style="{StaticResource TbIco}"/><TextBlock Text="복사" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button ToolTip="저장 (Ctrl+S)" Style="{StaticResource TbIconBtn}" Click="OnSave"><StackPanel><Image Source="/icons/save.png" Style="{StaticResource TbIco}"/><TextBlock Text="저장" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button ToolTip="화면에 고정(핀) — 항상 위에 떠 있는 창으로" Style="{StaticResource TbIconBtn}" Click="OnPin"><StackPanel><Path Data="M6,1 L12,1 L11,7 L14,10 L9.6,10 L9,17 L8.4,10 L4,10 L7,7 Z" Fill="#FF6B6B" Width="18" Height="18" Stretch="Uniform"/><TextBlock Text="핀" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Button ToolTip="닫기 (Esc)" Style="{StaticResource TbIconBtn}" Click="OnClose"><StackPanel><Image Source="/icons/close.png" Style="{StaticResource TbIco}"/><TextBlock Text="닫기" Style="{StaticResource Lbl}"/></StackPanel></Button>
                            <Border Style="{StaticResource Sep}"/>
                            <!-- 줌: 세그먼트 컨트롤 -->
                            <Border Background="#14FFFFFF" CornerRadius="9" Height="30" VerticalAlignment="Center" Padding="2,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Width="26" Height="26" ToolTip="축소 (Ctrl+휠 / Ctrl+-)" Style="{StaticResource TbBtn}" Click="OnZoomOut"><TextBlock Text="−" FontSize="15" Foreground="#E8E8EC"/></Button>
                                    <Button x:Name="BtnZoom" Width="46" Height="26" ToolTip="화면에 맞춤 / 100% (Ctrl+0)" Style="{StaticResource TbBtn}" Click="OnZoomFit"><TextBlock x:Name="ZoomLabel" Text="100%" FontSize="11" Foreground="#E8E8EC"/></Button>
                                    <Button Width="26" Height="26" ToolTip="확대 (Ctrl+휠 / Ctrl++)" Style="{StaticResource TbBtn}" Click="OnZoomIn"><TextBlock Text="+" FontSize="15" Foreground="#E8E8EC"/></Button>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Sep}"/>
                            <Button x:Name="BtnOpts" ToolTip="스타일 옵션" Style="{StaticResource TbIconBtn}" Click="OnToggleOpts"><StackPanel><Image Source="/icons/opts.png" Style="{StaticResource TbIco}"/><TextBlock Text="옵션" Style="{StaticResource Lbl}"/></StackPanel></Button>
                        </StackPanel>
                      <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
                        <Border Height="1" Background="#14FFFFFF" Margin="2,7,2,0"/>
                        <StackPanel x:Name="StyleRow" Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock Text="색상" Foreground="#A6FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Sep}"/>
                            <TextBlock Text="굵기" Foreground="#A6FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnW1" Content="▁" FontSize="13" ToolTip="얇게" Style="{StaticResource TbBtn}" Click="OnWidth" Tag="2"/>
                            <Button x:Name="BtnW2" Content="―" FontSize="13" ToolTip="보통" Style="{StaticResource TbBtn}" Click="OnWidth" Tag="4"/>
                            <Button x:Name="BtnW3" Content="▬" FontSize="13" ToolTip="굵게" Style="{StaticResource TbBtn}" Click="OnWidth" Tag="7"/>
                            <Border Style="{StaticResource Sep}"/>
                            <Button x:Name="BtnHatch" Content="▨" FontSize="13" ToolTip="빗금 채우기" Style="{StaticResource TbBtn}" Click="OnHatch"/>
                            <Border Style="{StaticResource Sep}"/>
                            <CheckBox x:Name="AutoCalloutChk" Content="네모→콜아웃" Foreground="#E8E8EC" VerticalAlignment="Center" FontSize="11"/>
                            <CheckBox x:Name="PenAutoChk" Content="펜 자동 도형" Foreground="#E8E8EC" VerticalAlignment="Center" FontSize="11" Margin="10,0,4,0"
                                      ToolTip="펜으로 그린 네모·원·화살표·직선을 깔끔하게 정리 (Shift = 끄고 그리기, Ctrl+Z = 원래 선)" Click="OnPenAuto"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="폰트" Foreground="#A6FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,6,0"/>
                            <Button x:Name="BtnFMinus" Content="−" Style="{StaticResource TbBtn}" Click="OnFontStep" Tag="-2"/>
                            <ComboBox x:Name="FontBox" Width="52" Height="24" IsEditable="True" Margin="3,0" VerticalContentAlignment="Center" FontSize="11"
                                      SelectionChanged="OnFontBox" LostFocus="OnFontBox" KeyUp="OnFontBox">
                                <ComboBoxItem>12</ComboBoxItem><ComboBoxItem>14</ComboBoxItem><ComboBoxItem>16</ComboBoxItem>
                                <ComboBoxItem>20</ComboBoxItem><ComboBoxItem>24</ComboBoxItem><ComboBoxItem>28</ComboBoxItem>
                                <ComboBoxItem>32</ComboBoxItem><ComboBoxItem>40</ComboBoxItem><ComboBoxItem>48</ComboBoxItem>
                                <ComboBoxItem>60</ComboBoxItem><ComboBoxItem>72</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="BtnFPlus" Content="+" Style="{StaticResource TbBtn}" Click="OnFontStep" Tag="2"/>
                            <Border Style="{StaticResource Sep}"/>
                            <TextBlock Text="정렬" Foreground="#A6FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Button x:Name="BtnAL" Style="{StaticResource TbBtn}" Click="OnAlign" Tag="Left"  ToolTip="왼쪽 정렬"/>
                            <Button x:Name="BtnAC" Style="{StaticResource TbBtn}" Click="OnAlign" Tag="Center" ToolTip="가운데 정렬"/>
                            <Button x:Name="BtnAR" Style="{StaticResource TbBtn}" Click="OnAlign" Tag="Right" ToolTip="오른쪽 정렬"/>
                            <Border Style="{StaticResource Sep}"/>
                            <TextBlock Text="시작 도구" Foreground="#A6FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="DefaultToolBox" Width="92" Height="24" FontSize="11" VerticalContentAlignment="Center"
                                      ToolTip="편집창을 열면 바로 선택될 도구" SelectionChanged="OnDefaultTool">
                                <ComboBoxItem Tag="select">선택</ComboBoxItem><ComboBoxItem Tag="spot">스포트</ComboBoxItem>
                                <ComboBoxItem Tag="arrow">화살표</ComboBoxItem><ComboBoxItem Tag="rect">사각형</ComboBoxItem>
                                <ComboBoxItem Tag="ellipse">원</ComboBoxItem><ComboBoxItem Tag="pen">펜</ComboBoxItem>
                                <ComboBoxItem Tag="hl">형광펜</ComboBoxItem><ComboBoxItem Tag="blur">블러</ComboBoxItem>
                                <ComboBoxItem Tag="text">텍스트</ComboBoxItem><ComboBoxItem Tag="callout">콜아웃</ComboBoxItem>
                                <ComboBoxItem Tag="num">넘버</ComboBoxItem><ComboBoxItem Tag="crop">자르기</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
