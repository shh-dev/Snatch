<Window x:Class="Snatch.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="340" Opacity="0"
        MouseEnter="OnMouseEnterCard" MouseLeave="OnMouseLeaveCard">
    <Border CornerRadius="12" Margin="10" Background="#FF1E1E24"
            BorderBrush="#FFB4FF00" BorderThickness="2">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="14,12,14,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- top: icon + name + size + close -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconHost" Grid.Column="0" Width="44" Height="44"
                        Background="#22FFFFFF" CornerRadius="8" Cursor="SizeAll"
                        ToolTip="여기를 끌어서 파일 옮기기 (드래그)"
                        MouseLeftButtonDown="OnDragStartDown" MouseMove="OnDragMove">
                    <Image x:Name="FileIcon" Width="32" Height="32" Stretch="Uniform"
                           SnapsToDevicePixels="True"/>
                </Border>

                <StackPanel x:Name="TextArea" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                            Background="Transparent" Cursor="SizeAll"
                            ToolTip="여기를 끌어서 파일 옮기기 (드래그)"
                            MouseLeftButtonDown="OnDragStartDown" MouseMove="OnDragMove">
                    <TextBlock x:Name="NameText" Text="파일" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="MetaText" Text="" Foreground="#AAB0B8" FontSize="11" Margin="0,2,0,0"/>
                    <TextBlock Text="↕ 끌어서 옮기기" Foreground="#6699D8FF" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="✕" Width="22" Height="22"
                        VerticalAlignment="Top" Foreground="#AAB0B8" Background="Transparent"
                        BorderThickness="0" FontSize="12" Cursor="Hand" Click="OnClose"/>
            </Grid>

            <!-- bottom: favorite move buttons + open folder -->
            <WrapPanel x:Name="FavPanel" Grid.Row="1" Margin="0,12,0,0"/>
        </Grid>
    </Border>
</Window>
